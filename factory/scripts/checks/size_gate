#!/usr/bin/env python3
"""The size gate: a plan's own size estimate at S3, a real diff's line count at S5.

Standalone: no import of `runner`. Two modes share one threshold rule --
under the tier's `size_gate` threshold (`tiers.yaml`) passes outright; over
it passes only when the plan's `Size` table carries a non-empty
`justification`, and says so. Plan mode reads the estimate straight from
the approved plan's own `Size` table; diff mode counts added-plus-removed
lines from a unified diff, excluding lockfiles and `project.yaml`'s
configured generated paths, but still checks the justification against the
same approved plan. The plan text is parsed with a small local pipe-table
reader rather than `runner.artefacts` -- a script under this directory
never imports the trusted control plane's own code.
"""
import argparse
import fnmatch
import json
import re
import subprocess
import sys
from pathlib import Path

import yaml


def _repo_root() -> Path:
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit("not inside a git repository; pass --tiers-config/--project-config explicitly")
    return Path(result.stdout.strip())


def _extract_section(text: str, title: str) -> str:
    match = re.search(rf"^## {re.escape(title)}[ \t]*$", text, re.MULTILINE)
    if not match:
        return ""
    start = match.end()
    rest = text[start:]
    next_heading = re.search(r"^## ", rest, re.MULTILINE)
    return rest[: next_heading.start()] if next_heading else rest


def _parse_pipe_table(section_text: str) -> list[dict[str, str]]:
    lines = [line for line in section_text.splitlines() if line.lstrip().startswith("|")]
    if len(lines) < 2:
        return []
    header = [cell.strip() for cell in lines[0].strip().strip("|").split("|")]
    rows = []
    for line in lines[2:]:
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        cells += [""] * (len(header) - len(cells))
        rows.append(dict(zip(header, cells)))
    return rows


def _size_rows(plan_path: Path) -> list[dict[str, str]]:
    return _parse_pipe_table(_extract_section(plan_path.read_text(), "Size"))


def _justification(size_rows: list[dict[str, str]]) -> str:
    for row in size_rows:
        text = (row.get("justification") or "").strip()
        if text:
            return text
    return ""


def _parse_diff(text: str) -> dict[str, int]:
    """`{path: added_plus_removed}` from unified diff text, one entry per `diff --git` file block."""
    counts: dict[str, int] = {}
    current: str | None = None
    for line in text.splitlines():
        if line.startswith("diff --git "):
            token = line.split(" ")[-1]
            current = token[2:] if token.startswith("b/") else token
            counts.setdefault(current, 0)
            continue
        if current is None or line.startswith("+++") or line.startswith("---"):
            continue
        if line.startswith("+") or line.startswith("-"):
            counts[current] += 1
    return counts


def _excluded(path: str, patterns: list[str]) -> bool:
    name = Path(path).name
    return any(fnmatch.fnmatch(path, pattern) or fnmatch.fnmatch(name, pattern) for pattern in patterns)


def _exclusion_patterns(project_path: Path) -> list[str]:
    doc = yaml.safe_load(Path(project_path).read_text()) or {}
    return list(doc.get("lockfiles", []) or []) + list(doc.get("generated_paths", []) or [])


def _threshold(tiers_path: Path, tier: str) -> int:
    doc = yaml.safe_load(Path(tiers_path).read_text())
    return doc["size_gate"][tier]


def _verdict(lines: int, threshold: int, justification: str) -> tuple[bool, str]:
    if lines <= threshold:
        return True, "within threshold"
    if justification:
        return True, f"over threshold but justified: {justification}"
    return False, "over threshold with no justification"


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="size_gate")
    parser.add_argument("--plan", required=True, type=Path)
    parser.add_argument("--tier", required=True)
    parser.add_argument("--diff", type=Path, default=None, help="unified diff text file; switches to diff mode")
    parser.add_argument("--tiers-config", type=Path, default=None)
    parser.add_argument("--project-config", type=Path, default=None)
    args = parser.parse_args(argv)

    root = None
    tiers_path = args.tiers_config
    project_path = args.project_config
    if tiers_path is None or (args.diff is not None and project_path is None):
        root = _repo_root()
    tiers_path = tiers_path or (root / "factory" / "config" / "tiers.yaml")
    threshold = _threshold(tiers_path, args.tier)

    size_rows = _size_rows(args.plan)
    justification = _justification(size_rows)

    if args.diff is None:
        lines = sum(int(row.get("estimated_lines") or 0) for row in size_rows)
    else:
        project_path = project_path or (root / "factory" / "config" / "project.yaml")
        patterns = _exclusion_patterns(project_path)
        per_file = _parse_diff(args.diff.read_text())
        lines = sum(count for path, count in per_file.items() if not _excluded(path, patterns))

    passed, reason = _verdict(lines, threshold, justification)
    print(json.dumps({"result": "pass" if passed else "fail", "lines": lines, "threshold": threshold, "reason": reason}, sort_keys=True))
    return 0 if passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
