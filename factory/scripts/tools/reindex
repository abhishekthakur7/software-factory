#!/usr/bin/env python3
"""Refresh the code graph index for a worktree, through the installed `codegraph` CLI.

Standalone: no import of `runner`. `codegraph` is an operator-installed
binary, not something this repository vendors, so an absent binary is a
plain, expected failure -- printed as a JSON reason on stdout and a
non-zero exit -- rather than a raised exception with a traceback.
"""
import argparse
import json
import shutil
import subprocess
import sys


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="reindex")
    parser.add_argument("worktree")
    args = parser.parse_args(argv)

    binary = shutil.which("codegraph")
    if binary is None:
        print(json.dumps({"ok": False, "reason": "codegraph is not installed"}))
        return 1

    result = subprocess.run([binary, "index", args.worktree], capture_output=True, text=True)
    if result.returncode != 0:
        reason = result.stderr.strip() or f"codegraph index exited {result.returncode}"
        print(json.dumps({"ok": False, "reason": reason}))
        return 1

    print(json.dumps({"ok": True, "reason": None}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
