#!/usr/bin/env python3
"""Assemble the `pr_body` artefact from `packet_inputs.json`: the packet's own narrative and
evidence links, minus the literal branch diff -- GitHub's own diff view is the pull request's
diff surface. Shares its section-building with `packet_assemble` through `packet_render.py`.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import packet_render


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="pr_body_assemble")
    parser.add_argument("--inputs", required=True, type=Path)
    parser.add_argument("--out", required=True, type=Path)
    args = parser.parse_args(argv)

    try:
        data = packet_render.load_inputs(args.inputs)
        text = packet_render.render(data, include_diff=False)
    except (packet_render.PacketInputError, OSError, KeyError, TypeError) as exc:
        print(f"pr_body_assemble: {exc}", file=sys.stderr)
        return 1

    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
